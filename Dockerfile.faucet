FROM golang:1.25-alpine AS builder

RUN apk add --no-cache gcc musl-dev

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /frg-faucet ./cmd/frg-faucet

FROM alpine:latest
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /frg-faucet /usr/local/bin/frg-faucet
ENTRYPOINT ["frg-faucet"]
