(module
  (import "frg" "state_get" (func $state_get (param i32 i32 i32 i32) (result i32)))
  (import "frg" "state_set" (func $state_set (param i32 i32 i32 i32)))
  (import "frg" "log" (func $log (param i32 i32)))
  (memory (export "memory") 1)
  (func (export "init"))
  (func (export "call")
    (local $i i32)
    (local $x i32)
    (local $off i32)
    (loop $calc_loop
      (i32.add (local.get $x) (i32.const 7))
      (local.set $x)
      (i32.div_u (local.get $x) (i32.const 3))
      (local.set $x)
      (i32.mul (local.get $x) (i32.const 13))
      (local.set $x)
      (i32.and (local.get $x) (i32.const 0xFFF))
      (local.set $x)
      (i32.add (local.get $i) (i32.const 1))
      (local.tee $i)
      (i32.const 10000)
      (i32.lt_u)
      (br_if $calc_loop))
    (i32.store (i32.const 0) (local.get $x))
    (i32.const 0)
    (local.set $i)
    (loop $state_loop
      (i32.store (local.get $off) (local.get $i))
      (call $state_set (local.get $off) (i32.const 4) (local.get $off) (i32.const 4))
      (call $state_get (local.get $off) (i32.const 4) (i32.const 256) (i32.const 64))
      (drop)
      (i32.add (local.get $off) (i32.const 4))
      (local.set $off)
      (i32.add (local.get $i) (i32.const 1))
      (local.tee $i)
      (i32.const 100)
      (i32.lt_u)
      (br_if $state_loop))
    (i32.const 0)
    (local.set $i)
    (loop $log_loop
      (call $log (i32.const 0) (i32.const 4))
      (i32.add (local.get $i) (i32.const 1))
      (local.tee $i)
      (i32.const 1000)
      (i32.lt_u)
      (br_if $log_loop)))
)
