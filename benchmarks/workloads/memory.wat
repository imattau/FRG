(module
  (memory (export "memory") 1)
  (func (export "init"))
  (func (export "call")
    (local $j i32)
    (local $ptr i32)
    (local $val i32)
    (loop $outer
      (i32.const 0)
      (local.set $ptr)
      (loop $inner
        (i32.store (local.get $ptr) (local.get $val))
        (i32.add (local.get $ptr) (i32.const 4))
        (local.tee $ptr)
        (i32.const 65536)
        (i32.lt_u)
        (br_if $inner))
      (i32.add (local.get $j) (i32.const 1))
      (local.tee $j)
      (i32.add (local.get $val) (i32.const 1))
      (local.set $val)
      (i32.const 20)
      (i32.lt_u)
      (br_if $outer)))
)
