(module
  (memory (export "memory") 1)
  (func (export "init"))
  (func (export "call")
    (local $i i32)
    (local $x i32)
    (loop $loop
      (i32.add (local.get $x) (i32.const 7))
      (local.set $x)
      (i32.div_u (local.get $x) (i32.const 3))
      (local.set $x)
      (i32.mul (local.get $x) (i32.const 13))
      (local.set $x)
      (i32.and (local.get $x) (i32.const 0xFFF))
      (local.set $x)
      (i32.add (local.get $i) (i32.const 1))
      (local.tee $i)
      (i32.const 100000)
      (i32.lt_u)
      (br_if $loop))
    (i32.store (i32.const 0) (local.get $x)))
)
