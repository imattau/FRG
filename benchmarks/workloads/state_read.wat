(module
  (import "frg" "state_get" (func $state_get (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (func (export "init"))
  (func (export "call")
    (local $i i32)
    (local $key_off i32)
    (loop $loop
      (i32.store (local.get $key_off) (local.get $i))
      (call $state_get (local.get $key_off) (i32.const 4) (i32.const 256) (i32.const 1024))
      (drop)
      (i32.add (local.get $key_off) (i32.const 4))
      (local.set $key_off)
      (i32.add (local.get $i) (i32.const 1))
      (local.tee $i)
      (i32.const 100)
      (i32.lt_u)
      (br_if $loop)))
)
